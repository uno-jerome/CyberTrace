# ──────────────────────────────────────────────
# CyberTrace Backend — Environment Variables
# Copy this file to .env and configure local values
# ──────────────────────────────────────────────

# MongoDB connection string (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/cybertrace

# Express Server Port
PORT=5000

# JSON Web Token Secret for Investigator & Admin Auth
JWT_SECRET=cybertrace_super_secure_jwt_secret_2026

# JWT Expiration Duration (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Environment Mode
NODE_ENV=development
